# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/reliefaid

# NextAuth
NEXTAUTH_SECRET=replace_with_a_random_long_string
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=evidence

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ── Email OTP (Nodemailer) ──────────────────────────────────────────────
# Leave blank for local dev — verification codes are logged to the server console
# (and returned by /api/otp/send as devCode when NODE_ENV !== production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReliefAid <no-reply@reliefaid.dev>"

# ── Phone OTP (Firebase Phone Auth / SMS provider) ──────────────────────
# Integration point lives in src/lib/sms.ts. Leave blank for local dev —
# codes are logged to the server console like email above.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google sign-in via Supabase OAuth ───────────────────────────────────
# Enable the Google provider in your Supabase dashboard (Authentication → Providers).
# Reuses the NEXT_PUBLIC_SUPABASE_* values above; no extra keys needed here.
