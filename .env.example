# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/reliefaid

# NextAuth
NEXTAUTH_SECRET=replace_with_a_random_long_string
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=evidence

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ── Email OTP (Nodemailer) ──────────────────────────────────────────────
# Leave blank for local dev — verification codes are logged to the server console
# (and returned by /api/otp/send as devCode when NODE_ENV !== production).
# Easiest for a Gmail account: enable 2-Step Verification, then create an
# "App Password" (myaccount.google.com/apppasswords) and use it as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReliefAid <no-reply@reliefaid.dev>"

# ── Payments (JazzCash Hosted Checkout) ─────────────────────────────────
# Leave blank for local dev — the built-in demo gateway (/pay/demo) exercises the
# same pending → paid/failed flow. For the real sandbox, register free at
# https://sandbox.jazzcash.com.pk to get a Merchant ID, Password, and Integrity
# Salt, then set all three below (gateway activates automatically).
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Optional override; defaults to the JazzCash sandbox endpoint.
# JAZZCASH_GATEWAY_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ── Phone OTP (Twilio SMS) ──────────────────────────────────────────────
# Sender lives in src/lib/sms.ts and delivers the code the server already made.
# Leave blank for local dev — codes are logged to the server console like email.
# From your Twilio console: Account SID, Auth Token, and a Twilio phone number
# (E.164, e.g. +15005550006). Trial accounts can only text verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Google sign-in via Supabase OAuth ───────────────────────────────────
# Enable the Google provider in your Supabase dashboard (Authentication → Providers).
# Reuses the NEXT_PUBLIC_SUPABASE_* values above; no extra keys needed here.
